{
  "name": "card-guild",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run content:check && npm run assets:check && vite",
    "build": "npm run content:check && npm run assets && tsc --noEmit && vite build",
    "check": "npm run content:check && npm run assets:check && npm run typecheck && npm run typecheck:game && npm run typecheck:tools && npm run lint && npm run test:unit",
    "assets:build": "tsx tools/assets/build-assets.ts",
    "assets:check": "tsx tools/assets/check-assets.ts",
    "assets": "npm run assets:build && npm run assets:check",
    "content:check": "tsx tools/content/check-content.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:smoke",
    "test:smoke": "playwright test",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:game": "tsc --project tsconfig.game.json",
    "typecheck:tools": "tsc --project tsconfig.tools.json"
  },
  "dependencies": {
    "pixi.js": "^8.20.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "ajv": "^8.20.0",
    "eslint": "^10.0.0",
    "globals": "^17.11.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  }
}
