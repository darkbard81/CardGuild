{
  "name": "card-guild",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run content:check && npm run assets:check && vite",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:coop": "tsx tools/dev-coop.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run content:check && npm run assets && tsc --noEmit && vite build",
    "build:server": "esbuild src/server/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/main.js --external:ws",
    "check": "npm run content:check && npm run content:production-check && npm run assets:check && npm run typecheck && npm run typecheck:game && npm run typecheck:tools && npm run typecheck:server && npm run lint && npm run test:unit",
    "assets:build": "tsx tools/assets/build-assets.ts",
    "assets:check": "tsx tools/assets/check-assets.ts",
    "assets": "npm run assets:build && npm run assets:check",
    "content:check": "tsx tools/content/check-content.ts",
    "content:production-check": "tsx tools/content/check-production-content.ts",
    "lint": "eslint .",
    "playtest": "tsx tools/playtest/run-playtest.ts",
    "preview": "vite preview",
    "server:check": "npm run typecheck:server",
    "start:production": "node --env-file=deploy/cardguild.production.env dist-server/main.js",
    "start:server": "node dist-server/main.js",
    "test": "npm run test:unit && npm run test:network && npm run test:smoke",
    "test:network": "vitest run --config vitest.network.config.ts",
    "test:smoke": "playwright test",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:game": "tsc --project tsconfig.game.json",
    "typecheck:tools": "tsc --project tsconfig.tools.json",
    "typecheck:server": "tsc --project tsconfig.server.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "pixi.js": "^8.20.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "globals": "^17.11.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  }
}
