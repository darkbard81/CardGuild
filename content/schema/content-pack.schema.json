{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardGuild Content Pack v13",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "traits", "conditions", "actions", "cards", "equipment", "actors", "scenarios", "adventures", "ancestries", "classes"],
  "properties": {
    "companions": { "type": "array", "items": { "$ref": "#/$defs/companion" } },
    "creationPresets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "actorDefinitionId",
          "appearance"
        ],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "actorDefinitionId": {
            "type": "string",
            "minLength": 1
          },
          "appearance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "male",
              "female"
            ],
            "properties": {
              "male": {
                "type": "string",
                "minLength": 1
              },
              "female": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "manifest": { "$ref": "#/$defs/manifest" },
    "traits": { "type": "array", "items": { "$ref": "#/$defs/traitDefinition" } },
    "conditions": { "type": "array", "items": { "$ref": "#/$defs/conditionDefinition" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/actionDefinition" } },
    "cards": { "type": "array", "items": { "$ref": "#/$defs/cardDefinition" } },
    "equipment": { "type": "array", "items": { "$ref": "#/$defs/equipmentDefinition" } },
    "actors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/actorDefinition" } },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } },
    "adventures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/adventure" } },
    "ancestries": {"type": "array", "items": {"$ref": "#/$defs/ancestryDefinition"}},
    "classes": {"type": "array", "items": {"$ref": "#/$defs/classDefinition"}}
  },
  "$defs": {
    "companion": {"type": "object", "additionalProperties": false, "required": ["id", "actorDefinitionId", "description", "appearanceKey", "startingExperience"], "properties": {"id": {"type": "string", "minLength": 1}, "actorDefinitionId": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "appearanceKey": {"type": "string", "minLength": 1}, "startingExperience": {"type": "integer", "minimum": 0, "maximum": 999}}},
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "attributeId": { "enum": ["str", "dex", "con", "int", "wis", "cha"] },
    "proficiencyRank": { "enum": ["untrained", "trained", "expert", "master", "legendary"] },
    "saveId": { "enum": ["fortitude", "reflex", "will"] },
    "armorCategory": { "enum": ["unarmored", "light", "medium", "heavy"] },
    "skillId": { "enum": ["acrobatics", "arcana", "athletics", "crafting", "deception", "diplomacy", "intimidation", "medicine", "nature", "occultism", "performance", "religion", "society", "stealth", "survival", "thievery"] },
    "gridPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "traitInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "params": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        }
      }
    },
    "conditionInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "type": "integer" }
      }
    },
    "damageType": {
      "enum": [
        "slashing", "piercing", "bludgeoning", "force",
        "acid", "cold", "electricity", "fire", "mental", "poison", "sonic", "spirit", "vitality", "void"
      ]
    },
    "damageDie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "sides", "modifier", "damageType"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "sides": { "type": "integer", "minimum": 2 },
        "modifier": { "type": "integer" },
        "damageType": { "$ref": "#/$defs/damageType" }
      }
    },
    "weaponCategory": { "enum": ["unarmed", "simple", "martial", "advanced"] },
    "weaponAttackMode": { "enum": ["melee", "ranged"] },
    "weaponDamageDice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "sides", "damageType"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "sides": { "type": "integer", "minimum": 2 },
        "damageType": { "$ref": "#/$defs/damageType" }
      }
    },
    "characterWeaponProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "attackMode", "rangeFeet", "damage", "traits"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "category": { "$ref": "#/$defs/weaponCategory" },
        "attackMode": { "$ref": "#/$defs/weaponAttackMode" },
        "rangeFeet": { "type": "integer", "minimum": 1 },
        "damage": { "$ref": "#/$defs/weaponDamageDice" },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/traitInstance" } }
      }
    },
    "fixedStrikeProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "attackModifier", "rangeFeet", "damage", "traits"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "attackModifier": { "type": "integer" },
        "rangeFeet": { "type": "integer", "minimum": 1 },
        "damage": { "$ref": "#/$defs/damageDie" },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/traitInstance" } }
      }
    },
    "cardGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardDefinitionId", "count", "sourceId"],
      "properties": {
        "cardDefinitionId": { "$ref": "#/$defs/nonEmptyString" },
        "count": { "type": "integer", "minimum": 1 },
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "traitId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "actionTiming": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "actions"],
          "properties": {
            "kind": { "const": "turn" },
            "actions": { "enum": [1, 2, 3] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "reaction" } }
        }
      ]
    },
    "actionParticipant": { "enum": ["actor", "target"] },
    "actionStatisticRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "skill"],
          "properties": {
            "kind": { "const": "skill" },
            "skill": { "$ref": "#/$defs/skillId" },
            "attributeOverride": { "$ref": "#/$defs/attributeId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "save"],
          "properties": {
            "kind": { "const": "save" },
            "save": { "$ref": "#/$defs/saveId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "perception" } }
        }
      ]
    },
    "actionDcRef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "fixed" },
            "value": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "owner"],
          "properties": {
            "kind": { "const": "armor-class" },
            "owner": { "$ref": "#/$defs/actionParticipant" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "owner", "statistic"],
          "properties": {
            "kind": { "const": "statistic-dc" },
            "owner": { "$ref": "#/$defs/actionParticipant" },
            "statistic": { "$ref": "#/$defs/actionStatisticRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "owner"],
          "properties": {
            "kind": { "const": "class-dc" },
            "owner": { "$ref": "#/$defs/actionParticipant" }
          }
        }
      ]
    },
    "actionRange": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "weapon-reach" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "feet" },
            "value": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "actionOutcomeEffect": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "success"], "properties": { "kind": { "const": "record-knowledge" }, "success": { "type": "boolean" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "owner", "condition"],
          "properties": {
            "kind": { "const": "apply-condition" },
            "owner": { "$ref": "#/$defs/actionParticipant" },
            "condition": { "$ref": "#/$defs/nonEmptyString" },
            "value": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "owner", "condition"],
          "properties": {
            "kind": { "const": "remove-condition" },
            "owner": { "$ref": "#/$defs/actionParticipant" },
            "condition": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "actionId"],
          "properties": {
            "kind": { "const": "lock-action" },
            "actionId": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "owner", "dice", "flatModifier", "damageType"],
          "properties": {
            "kind": { "const": "damage" },
            "owner": { "$ref": "#/$defs/actionParticipant" },
            "dice": {
              "type": "object",
              "additionalProperties": false,
              "required": ["count", "sides"],
              "properties": {
                "count": { "type": "integer", "minimum": 1 },
                "sides": { "type": "integer", "minimum": 2 }
              }
            },
            "flatModifier": { "type": "integer" },
            "damageType": { "$ref": "#/$defs/damageType" },
            "multiplier": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "owner", "dice", "flatModifier"],
          "properties": {
            "kind": { "const": "restore-hp" },
            "owner": { "$ref": "#/$defs/actionParticipant" },
            "dice": {
              "type": "object",
              "additionalProperties": false,
              "required": ["count", "sides"],
              "properties": {
                "count": { "type": "integer", "minimum": 0 },
                "sides": { "type": "integer", "minimum": 2 }
              }
            },
            "flatModifier": { "type": "integer", "minimum": 0 },
            "multiplier": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "effectName"],
          "properties": {
            "kind": { "const": "create-sustained-effect" },
            "effectName": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "sustain-effect" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "raise-shield" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "interact" } }
        }
      ]
    },
    "degreeOutcomeMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical-success", "success", "failure", "critical-failure"],
      "properties": {
        "critical-success": { "type": "array", "items": { "$ref": "#/$defs/actionOutcomeEffect" } },
        "success": { "type": "array", "items": { "$ref": "#/$defs/actionOutcomeEffect" } },
        "failure": { "type": "array", "items": { "$ref": "#/$defs/actionOutcomeEffect" } },
        "critical-failure": { "type": "array", "items": { "$ref": "#/$defs/actionOutcomeEffect" } }
      }
    },
    "actionCheckDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roller", "statistic", "dc"],
      "properties": {
        "roller": { "$ref": "#/$defs/actionParticipant" },
        "statistic": { "$ref": "#/$defs/actionStatisticRef" },
        "dc": { "$ref": "#/$defs/actionDcRef" }
      }
    },
    "actionResolution": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "recall-knowledge" } } },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "movementMode", "step", "triggersReactions"],
          "properties": {
            "kind": { "const": "move" },
            "movementMode": { "enum": ["land", "fly"] },
            "step": { "type": "boolean" },
            "triggersReactions": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "damageMultiplier", "outcomes"],
          "properties": {
            "kind": { "const": "strike" },
            "damageMultiplier": { "type": "number", "exclusiveMinimum": 0 },
            "extraWeaponDice": { "type": "integer", "minimum": 1 },
            "outcomes": { "$ref": "#/$defs/degreeOutcomeMap" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "check", "outcomes"],
          "properties": {
            "kind": { "const": "check" },
            "check": { "$ref": "#/$defs/actionCheckDefinition" },
            "outcomes": { "$ref": "#/$defs/degreeOutcomeMap" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "effects"],
          "properties": {
            "kind": { "const": "direct" },
            "effects": { "type": "array", "items": { "$ref": "#/$defs/actionOutcomeEffect" } }
          }
        }
      ]
    },
    "actionRequirement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "mode"],
          "properties": {
            "kind": { "const": "weapon-mode" },
            "mode": { "$ref": "#/$defs/weaponAttackMode" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "slot"],
          "properties": {
            "kind": { "const": "equipped-slot" },
            "slot": { "enum": ["weapon", "armor", "shield", "feet"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "skill", "minimum"],
          "properties": {
            "kind": { "const": "skill-rank" },
            "skill": { "$ref": "#/$defs/skillId" },
            "minimum": { "$ref": "#/$defs/proficiencyRank" }
          }
        }
      ]
    },
    "actionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "timing", "traits", "targeting", "resolution"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "type": "string" },
        "timing": { "$ref": "#/$defs/actionTiming" },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/traitInstance" } },
        "targeting": { "enum": ["none", "self", "ally", "creature", "enemy", "tile", "object", "effect"] },
        "range": { "$ref": "#/$defs/actionRange" },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/actionRequirement" } },
        "mapAttackCount": { "enum": [1, 2, 3] },
        "resolution": { "$ref": "#/$defs/actionResolution" }
      }
    },
    "cardDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "actionId", "traits", "level"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "actionId": { "$ref": "#/$defs/nonEmptyString" },
        "level": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "levelByClass": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/traitInstance" } }
      }
    },
    "traitCardGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardDefinitionId", "count"],
      "properties": {
        "cardDefinitionId": { "$ref": "#/$defs/nonEmptyString" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "traitActionGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "contextGroup"],
      "properties": {
        "actionId": { "$ref": "#/$defs/nonEmptyString" },
        "contextGroup": { "enum": ["escape", "interact", "shield", "sustain"] }
      }
    },
    "traitSource": { "enum": ["pf2e-remaster", "cardguild"] },
    "traitCategory": {
      "enum": ["system", "ancestry", "class", "personality", "creature", "action", "weapon", "equipment", "condition", "terrain", "damage", "general"]
    },
    "traitDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "source", "category", "description", "cardGrants", "actionGrants"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "$ref": "#/$defs/traitSource" },
        "category": { "$ref": "#/$defs/traitCategory" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "cardGrants": { "type": "array", "items": { "$ref": "#/$defs/traitCardGrant" } },
        "actionGrants": { "type": "array", "items": { "$ref": "#/$defs/traitActionGrant" } },
        "statModifiers": { "type": "array", "items": { "$ref": "#/$defs/statModifier" } }
      }
    },
    "conditionValuePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "merge", "modifierScale"],
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 1 },
        "merge": { "const": "max" },
        "modifierScale": { "const": "multiply-by-value" },
        "endTurnDelta": { "const": -1 }
      }
    },
    "conditionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "traits"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/traitInstance" } },
        "statModifiers": { "type": "array", "items": { "$ref": "#/$defs/statModifier" } },
        "valuePolicy": { "$ref": "#/$defs/conditionValuePolicy" },
        "expiry": { "enum": ["actor-turn-start"] }
      }
    },
    "statModifierSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "all" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "perception" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "ac" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "attack" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "damage" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "class-dc" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "save" },
            "id": { "$ref": "#/$defs/saveId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "skill" },
            "id": { "$ref": "#/$defs/skillId" }
          }
        }
      ]
    },
    "statModifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "type", "value", "label"],
      "properties": {
        "selector": { "$ref": "#/$defs/statModifierSelector" },
        "type": { "enum": ["circumstance", "item", "status", "untyped"] },
        "value": { "type": "integer" },
        "label": { "$ref": "#/$defs/nonEmptyString" }
      },
      "if": { "required": ["type"], "properties": { "type": { "const": "untyped" } } },
      "then": { "properties": { "value": { "type": "integer", "maximum": -1 } } }
    },
    "equipmentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slot", "traits", "statModifiers"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "slot": { "enum": ["weapon", "armor", "shield", "feet"] },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/traitInstance" } },
        "statModifiers": { "type": "array", "items": { "$ref": "#/$defs/statModifier" } },
        "weaponProfile": { "$ref": "#/$defs/characterWeaponProfile" },
        "armorProfile": { "$ref": "#/$defs/armorProfile" },
        "shieldBonus": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "required": ["slot"], "properties": { "slot": { "const": "weapon" } } },
          "then": {
            "required": ["weaponProfile"],
            "properties": { "weaponProfile": { "$ref": "#/$defs/characterWeaponProfile" } }
          },
          "else": { "properties": { "weaponProfile": false } }
        },
        {
          "if": { "required": ["slot"], "properties": { "slot": { "const": "armor" } } },
          "then": {
            "required": ["armorProfile"],
            "properties": { "armorProfile": { "$ref": "#/$defs/armorProfile" } }
          },
          "else": { "properties": { "armorProfile": false } }
        },
        {
          "if": { "required": ["shieldBonus"], "properties": { "shieldBonus": { "type": "integer" } } },
          "then": { "properties": { "slot": { "const": "shield" } } }
        }
      ]
    },
    "armorProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "acItemBonus", "dexCap"],
      "properties": {
        "category": { "enum": ["light", "medium", "heavy"] },
