        "baseCardGrants": { "type": "array", "items": { "$ref": "#/$defs/cardGrant" } }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "statProfile": {"properties": {"kind": {"const": "character"}}, "required": ["kind"], "type": "object"}
            }
          },
          "then": {"properties": {"speedFeet": false}},
          "else": {"required": ["speedFeet"], "properties": {"speedFeet": {"type": "integer", "minimum": 0}}}
        }
      ]
    },
