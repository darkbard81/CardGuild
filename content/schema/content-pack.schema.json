    "actorDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "statProfile", "initialConditions", "traits", "loadoutProfile", "starterLoadout", "innateActionIds", "baseCardGrants"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
