{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CardGuild Content Pack v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest", "traits", "conditions", "actions", "cards", "equipment", "actors", "scenarios", "adventures"],
  "properties": {
    "manifest": { "$ref": "#/$defs/manifest" },
    "traits": { "type": "array", "items": { "$ref": "#/$defs/traitDefinition" } },
    "conditions": { "type": "array", "items": { "$ref": "#/$defs/conditionDefinition" } },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/actionDefinition" } },
    "cards": { "type": "array", "items": { "$ref": "#/$defs/cardDefinition" } },
    "equipment": { "type": "array", "items": { "$ref": "#/$defs/equipmentDefinition" } },
    "actors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/actorDefinition" } },
    "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } },
    "adventures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/adventure" } }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "attributeId": { "enum": ["str", "dex", "con", "int", "wis", "cha"] },
    "proficiencyRank": { "enum": ["untrained", "trained", "expert", "master", "legendary"] },
    "saveId": { "enum": ["fortitude", "reflex", "will"] },
    "armorCategory": { "enum": ["unarmored", "light", "medium", "heavy"] },
    "skillId": { "enum": ["acrobatics", "arcana", "athletics", "crafting", "deception", "diplomacy", "intimidation", "medicine", "nature", "occultism", "performance", "religion", "society", "stealth", "survival", "thievery"] },
    "gridPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "traitInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "params": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        }
      }
    },
    "conditionInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceId"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "sourceId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "damageDie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "sides", "modifier", "damageType"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "sides": { "type": "integer", "minimum": 2 },
        "modifier": { "type": "integer" },
        "damageType": { "enum": ["slashing", "piercing", "bludgeoning", "force"] }
      }
    },
    "weaponProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "attackModifier", "rangeFeet", "damage"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "attackModifier": { "type": "integer" },
        "rangeFeet": { "type": "integer", "minimum": 1 },
        "damage": { "$ref": "#/$defs/damageDie" }
      }
    },
    "cardGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardDefinitionId", "count", "sourceId"],
      "properties": {
        "cardDefinitionId": { "$ref": "#/$defs/nonEmptyString" },
        "count": { "type": "integer", "minimum": 1 },
        "sourceId": { "$ref": "#/$defs/nonEmptyString" },
        "traitId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "actionTiming": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "actions"],
          "properties": {
            "kind": { "const": "turn" },
            "actions": { "enum": [1, 2, 3] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "reaction" } }
        }
      ]
    },
    "degreeOutcomeEffect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "condition"],
          "properties": {
            "kind": { "const": "remove-condition" },
            "condition": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "actionId"],
          "properties": {
            "kind": { "const": "lock-action" },
            "actionId": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ]
    },
    "degreeOutcomeMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical-success", "success", "failure", "critical-failure"],
      "properties": {
        "critical-success": { "type": "array", "items": { "$ref": "#/$defs/degreeOutcomeEffect" } },
        "success": { "type": "array", "items": { "$ref": "#/$defs/degreeOutcomeEffect" } },
        "failure": { "type": "array", "items": { "$ref": "#/$defs/degreeOutcomeEffect" } },
        "critical-failure": { "type": "array", "items": { "$ref": "#/$defs/degreeOutcomeEffect" } }
      }
    },
    "actionEffect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "movementMode", "step", "triggersReactions"],
          "properties": {
            "kind": { "const": "move" },
            "movementMode": { "enum": ["land", "fly"] },
            "step": { "type": "boolean" },
            "triggersReactions": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "damageMultiplier"],
          "properties": {
            "kind": { "const": "weapon-attack" },
            "damageMultiplier": { "type": "number", "exclusiveMinimum": 0 },
            "applyCondition": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "trip" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "condition"],
          "properties": {
            "kind": { "const": "remove-condition" },
            "condition": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "condition", "modifier", "dc", "outcomes"],
          "properties": {
            "kind": { "const": "recovery-check" },
            "condition": { "$ref": "#/$defs/nonEmptyString" },
            "modifier": { "const": "athletics" },
            "dc": { "type": "integer", "minimum": 1 },
            "outcomes": { "$ref": "#/$defs/degreeOutcomeMap" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "raise-shield" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "interact" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "effectName"],
          "properties": {
            "kind": { "const": "create-sustained-effect" },
            "effectName": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "sustain-effect" } }
        }
      ]
    },
    "actionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "timing", "traits", "targeting", "effect"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "type": "string" },
        "timing": { "$ref": "#/$defs/actionTiming" },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/traitInstance" } },
        "targeting": { "enum": ["none", "self", "enemy", "tile", "object", "effect"] },
        "effect": { "$ref": "#/$defs/actionEffect" }
      }
    },
    "cardDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "actionId", "traits"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "actionId": { "$ref": "#/$defs/nonEmptyString" },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/traitInstance" } }
      }
    },
    "traitCardGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardDefinitionId", "count"],
      "properties": {
        "cardDefinitionId": { "$ref": "#/$defs/nonEmptyString" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "traitActionGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "contextGroup"],
      "properties": {
        "actionId": { "$ref": "#/$defs/nonEmptyString" },
        "contextGroup": { "enum": ["escape", "interact", "shield", "sustain"] }
      }
    },
    "traitDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "cardGrants", "actionGrants"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "cardGrants": { "type": "array", "items": { "$ref": "#/$defs/traitCardGrant" } },
        "actionGrants": { "type": "array", "items": { "$ref": "#/$defs/traitActionGrant" } },
        "statModifiers": { "type": "array", "items": { "$ref": "#/$defs/statModifier" } }
      }
    },
    "conditionDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "traits"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/traitInstance" } },
        "statModifiers": { "type": "array", "items": { "$ref": "#/$defs/statModifier" } }
      }
    },
    "statModifierSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "all" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "perception" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "ac" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "save" },
            "id": { "$ref": "#/$defs/saveId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "skill" },
            "id": { "$ref": "#/$defs/skillId" }
          }
        }
      ]
    },
    "statModifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "type", "value", "label"],
      "properties": {
        "selector": { "$ref": "#/$defs/statModifierSelector" },
        "type": { "enum": ["circumstance", "item", "status", "untyped"] },
        "value": { "type": "integer" },
        "label": { "$ref": "#/$defs/nonEmptyString" }
      },
      "if": { "required": ["type"], "properties": { "type": { "const": "untyped" } } },
      "then": { "properties": { "value": { "type": "integer", "maximum": -1 } } }
    },
    "equipmentDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "slot", "traits", "statModifiers"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "slot": { "enum": ["weapon", "armor", "shield", "feet"] },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/traitInstance" } },
        "statModifiers": { "type": "array", "items": { "$ref": "#/$defs/statModifier" } },
        "weaponProfile": { "$ref": "#/$defs/weaponProfile" },
        "armorProfile": { "$ref": "#/$defs/armorProfile" },
        "shieldBonus": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": { "required": ["slot"], "properties": { "slot": { "const": "armor" } } },
          "then": {
            "required": ["armorProfile"],
            "properties": { "armorProfile": { "$ref": "#/$defs/armorProfile" } }
          },
          "else": { "properties": { "armorProfile": false } }
        },
        {
          "if": { "required": ["shieldBonus"], "properties": { "shieldBonus": { "type": "integer" } } },
          "then": { "properties": { "slot": { "const": "shield" } } }
        }
      ]
    },
    "armorProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "acItemBonus", "dexCap"],
      "properties": {
        "category": { "enum": ["light", "medium", "heavy"] },
        "acItemBonus": { "type": "integer", "minimum": 0 },
        "dexCap": { "type": "integer", "minimum": 0 }
      }
    },
    "loadoutProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preparedCardCapacity"],
      "properties": {
        "preparedCardCapacity": { "type": "integer", "minimum": 0 }
      }
    },
    "starterEquipment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "weapon": { "$ref": "#/$defs/nonEmptyString" },
        "armor": { "$ref": "#/$defs/nonEmptyString" },
        "shield": { "$ref": "#/$defs/nonEmptyString" },
        "feet": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "starterLoadout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equipment", "preparedCards"],
      "properties": {
        "equipment": { "$ref": "#/$defs/starterEquipment" },
        "preparedCards": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "characterAttributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["str", "dex", "con", "int", "wis", "cha"],
      "properties": {
        "str": { "type": "integer" },
        "dex": { "type": "integer" },
        "con": { "type": "integer" },
        "int": { "type": "integer" },
        "wis": { "type": "integer" },
        "cha": { "type": "integer" }
      }
    },
    "characterSaves": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fortitude", "reflex", "will"],
      "properties": {
        "fortitude": { "$ref": "#/$defs/proficiencyRank" },
        "reflex": { "$ref": "#/$defs/proficiencyRank" },
        "will": { "$ref": "#/$defs/proficiencyRank" }
      }
    },
    "characterSkills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acrobatics", "arcana", "athletics", "crafting", "deception", "diplomacy", "intimidation", "medicine", "nature", "occultism", "performance", "religion", "society", "stealth", "survival", "thievery"],
      "properties": {
        "acrobatics": { "$ref": "#/$defs/proficiencyRank" },
        "arcana": { "$ref": "#/$defs/proficiencyRank" },
        "athletics": { "$ref": "#/$defs/proficiencyRank" },
        "crafting": { "$ref": "#/$defs/proficiencyRank" },
        "deception": { "$ref": "#/$defs/proficiencyRank" },
        "diplomacy": { "$ref": "#/$defs/proficiencyRank" },
        "intimidation": { "$ref": "#/$defs/proficiencyRank" },
        "medicine": { "$ref": "#/$defs/proficiencyRank" },
        "nature": { "$ref": "#/$defs/proficiencyRank" },
        "occultism": { "$ref": "#/$defs/proficiencyRank" },
        "performance": { "$ref": "#/$defs/proficiencyRank" },
        "religion": { "$ref": "#/$defs/proficiencyRank" },
        "society": { "$ref": "#/$defs/proficiencyRank" },
        "stealth": { "$ref": "#/$defs/proficiencyRank" },
        "survival": { "$ref": "#/$defs/proficiencyRank" },
        "thievery": { "$ref": "#/$defs/proficiencyRank" }
      }
    },
    "armorProficiencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unarmored", "light", "medium", "heavy"],
      "properties": {
        "unarmored": { "$ref": "#/$defs/proficiencyRank" },
        "light": { "$ref": "#/$defs/proficiencyRank" },
        "medium": { "$ref": "#/$defs/proficiencyRank" },
        "heavy": { "$ref": "#/$defs/proficiencyRank" }
      }
    },
    "characterDefenseProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ancestryHp", "classHpPerLevel", "armorProficiencies"],
      "properties": {
        "ancestryHp": { "type": "integer", "minimum": 1 },
        "classHpPerLevel": { "type": "integer", "minimum": 1 },
        "armorProficiencies": { "$ref": "#/$defs/armorProficiencies" }
      }
    },
    "characterStatProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "attributes", "perception", "saves", "skills", "defense"],
      "properties": {
        "level": { "type": "integer", "minimum": 1 },
        "attributes": { "$ref": "#/$defs/characterAttributes" },
        "perception": { "$ref": "#/$defs/proficiencyRank" },
        "saves": { "$ref": "#/$defs/characterSaves" },
        "skills": { "$ref": "#/$defs/characterSkills" },
        "defense": { "$ref": "#/$defs/characterDefenseProfile" }
      }
    },
    "fixedCreatureSaves": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fortitude", "reflex", "will"],
      "properties": {
        "fortitude": { "type": "integer" },
        "reflex": { "type": "integer" },
        "will": { "type": "integer" }
      }
    },
    "fixedCreatureSkills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "acrobatics": { "type": "integer" },
        "arcana": { "type": "integer" },
        "athletics": { "type": "integer" },
        "crafting": { "type": "integer" },
        "deception": { "type": "integer" },
        "diplomacy": { "type": "integer" },
        "intimidation": { "type": "integer" },
        "medicine": { "type": "integer" },
        "nature": { "type": "integer" },
        "occultism": { "type": "integer" },
        "performance": { "type": "integer" },
        "religion": { "type": "integer" },
        "society": { "type": "integer" },
        "stealth": { "type": "integer" },
        "survival": { "type": "integer" },
        "thievery": { "type": "integer" }
      }
    },
    "actorStatProfile": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stats"],
          "properties": {
            "kind": { "const": "character" },
            "stats": { "$ref": "#/$defs/characterStatProfile" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stats"],
          "properties": {
            "kind": { "const": "creature" },
            "stats": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ac", "maxHp", "perception", "saves", "skills"],
              "properties": {
                "ac": { "type": "integer", "minimum": 0 },
                "maxHp": { "type": "integer", "minimum": 1 },
                "perception": { "type": "integer" },
                "saves": { "$ref": "#/$defs/fixedCreatureSaves" },
                "skills": { "$ref": "#/$defs/fixedCreatureSkills" }
              }
            }
          }
        }
      ]
    },
    "actorDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "statProfile", "speedFeet", "fallbackWeapon", "initialConditions", "traits", "loadoutProfile", "starterLoadout", "innateActionIds", "baseCardGrants"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "statProfile": { "$ref": "#/$defs/actorStatProfile" },
        "speedFeet": { "type": "integer", "minimum": 0 },
        "fallbackWeapon": { "$ref": "#/$defs/weaponProfile" },
        "initialConditions": { "type": "array", "items": { "$ref": "#/$defs/conditionInstance" } },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/traitInstance" } },
        "loadoutProfile": { "$ref": "#/$defs/loadoutProfile" },
        "starterLoadout": { "$ref": "#/$defs/starterLoadout" },
        "innateActionIds": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "baseCardGrants": { "type": "array", "items": { "$ref": "#/$defs/cardGrant" } }
      }
    },
    "encounterActorPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceId", "actorDefinitionId", "team", "position", "facing"],
      "properties": {
        "instanceId": { "$ref": "#/$defs/nonEmptyString" },
        "actorDefinitionId": { "$ref": "#/$defs/nonEmptyString" },
        "team": { "const": "enemies" },
        "position": { "$ref": "#/$defs/gridPosition" },
        "facing": { "enum": ["north", "east", "south", "west"] }
      }
    },
    "partySpawnSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat", "position", "facing"],
      "properties": {
        "seat": { "enum": [1, 2, 3] },
        "position": { "$ref": "#/$defs/gridPosition" },
        "facing": { "enum": ["north", "east", "south", "west"] }
      }
    },
    "tileDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position", "traits"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "position": { "$ref": "#/$defs/gridPosition" },
        "traits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/traitInstance" } }
      }
    },
    "mapInteraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetTileId"],
      "properties": {
        "kind": { "const": "open-gate" },
        "targetTileId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "mapObjectDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "position", "traits", "interaction", "used"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "position": { "$ref": "#/$defs/gridPosition" },
        "traits": { "type": "array", "items": { "$ref": "#/$defs/traitInstance" } },
        "interaction": { "$ref": "#/$defs/mapInteraction" },
        "used": { "type": "boolean" }
      }
    },
    "battleMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "tiles", "objects"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "tiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tileDefinition" } },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/mapObjectDefinition" } }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "objective", "placements", "partySpawnSlots", "map"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description"],
          "properties": {
            "kind": { "const": "defeat-all-enemies" },
            "description": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "placements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/encounterActorPlacement" } },
        "partySpawnSlots": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/partySpawnSlot" } },
        "map": { "$ref": "#/$defs/battleMap" }
      }
    },
    "rewardGrant": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "definitionId"],
          "properties": {
            "kind": { "const": "equipment" },
            "definitionId": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "definitionId"],
          "properties": {
            "kind": { "const": "card" },
            "definitionId": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ]
    },
    "adventureReward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "afterEncounterId", "choices"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "afterEncounterId": { "$ref": "#/$defs/nonEmptyString" },
        "choices": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rewardGrant" } }
      }
    },
    "adventure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "partySize", "encounterIds", "rewards"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "type": "string" },
        "partySize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "enum": [1, 2, 3] },
            "max": { "enum": [1, 2, 3] }
          }
        },
        "encounterIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "rewards": { "type": "array", "items": { "$ref": "#/$defs/adventureReward" } }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "version", "rulesetId"],
      "properties": {
        "schemaVersion": { "const": 6 },
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "rulesetId": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
