      "canvas": { "width": 256, "height": 256 },
      "frames": [
        { "assetId": "terrain.stone-floor", "kind": "terrain", "anchor": { "x": 0.5, "y": 0.5 }, "displaySize": { "width": 128, "height": 128 }, "footprint": { "width": 128, "height": 128 } }
      ],
      "prompt": "Reference art/STYLE.md and documents/view_modify.png. 2d top-down square dungeon stone floor Board Tile. 1:1ratio 굵은 외곽선과 투명배경."
    },
