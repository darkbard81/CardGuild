  "presentation": {
    "terrainVisuals": {
      "open": "terrain.stone-floor",
      "difficult": "terrain.rubble",
      "impassable": "terrain.chasm",
      "web": "transition.web",
      "blocked": "object.wall"
    },
    "objectVisuals": {
      "wall": "object.wall",
      "crate": "object.crate",
      "lever": "object.lever",
      "gateClosed": "object.gate.closed",
      "gateOpen": "object.gate.open"
