{
  "version": 3,
  "styleSheet": "art/STYLE.md",
  "promptConvention": "documents/ImageGen_Prompt.md",
  "background": "transparent",
  "atlas": {
    "size": 2048,
    "padding": 2,
    "image": "public/assets/m3-atlas.webp",
    "data": "public/assets/m3-atlas.json"
